---
import '../styles/v4.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Morgentidende',
  description = 'Morgentidende – få begge sider af sagen i Danmarks nye avis'
} = Astro.props;
---
<!doctype html>
<html lang="da" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
    <style is:inline>
      /* Two-layer masthead: the lower band scrolls behind the fixed top band. */
      .v4-masthead {
        position: fixed !important;
        inset: 0 0 auto 0 !important;
        z-index: 100 !important;
        width: 100% !important;
        height: 0 !important;
        padding: 0 !important;
        background: transparent !important;
        border: 0 !important;
        box-shadow: none !important;
        overflow: visible !important;
        pointer-events: none;
        transform: none !important;
      }

      .v4-masthead-top {
        position: relative;
        z-index: 2;
        height: 96px;
        padding: 18px max(24px, calc((100vw - var(--v4-max)) / 2));
        display: flex;
        align-items: center;
        background: linear-gradient(115deg, var(--v4-navy), var(--v4-purple));
        color: #f8f4ec;
        border-bottom: 1px solid rgba(255,255,255,.14);
        pointer-events: auto;
        transform: translateZ(0);
      }

      .v4-masthead-top .v4-masthead__inner {
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
        align-items: center;
        gap: 24px;
      }

      .v4-masthead-top .v4-brand {
        grid-column: 2;
        display: inline-flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
        transform-origin: center center;
        will-change: transform;
      }

      .v4-masthead-top .v4-brand__sun {
        width: 58px !important;
        height: 58px !important;
      }

      .v4-masthead-top .v4-brand__word {
        font-size: clamp(44px,6vw,72px) !important;
      }

      .v4-masthead-top .v4-masthead__actions {
        grid-column: 3;
        justify-self: end;
      }

      .v4-masthead-lower {
        position: fixed;
        z-index: 1;
        top: 96px;
        left: 0;
        width: 100%;
        height: 98px;
        padding: 0 max(24px, calc((100vw - var(--v4-max)) / 2));
        background: linear-gradient(115deg, var(--v4-navy), var(--v4-purple));
        color: #f8f4ec;
        border-bottom: 1px solid rgba(255,255,255,.14);
        pointer-events: auto;
        transform: translate3d(0,0,0);
        will-change: transform;
      }

      .v4-masthead-lower .v4-meta-row {
        height: 54px !important;
        margin: 0 !important;
        padding: 18px 0 !important;
        border-top: 1px solid rgba(255,255,255,.18);
        border-bottom: 1px solid rgba(255,255,255,.18);
        opacity: 1 !important;
        transform: none !important;
      }

      .v4-masthead-lower .v4-nav {
        height: 44px !important;
        margin: 0 !important;
        padding: 16px 0 0 !important;
        opacity: 1 !important;
        transform: none !important;
        overflow: visible !important;
      }

      .v4-masthead-spacer { height: 194px !important; }

      @media (max-width:900px) {
        .v4-masthead-top { height: 78px; padding: 13px 20px; }
        .v4-masthead-top .v4-masthead__inner { grid-template-columns:minmax(0,1fr) auto; gap:16px; }
        .v4-masthead-top .v4-brand { grid-column:1; transform-origin:left center; }
        .v4-masthead-top .v4-brand__sun { width:44px !important; height:44px !important; }
        .v4-masthead-top .v4-brand__word { font-size:clamp(36px,9vw,54px) !important; }
        .v4-masthead-top .v4-masthead__actions { grid-column:2; }
        .v4-masthead-lower { top:78px; height:52px; padding:0 20px; }
        .v4-masthead-lower .v4-meta-row { display:none !important; }
        .v4-masthead-lower .v4-nav { height:52px !important; padding-top:17px !important; justify-content:flex-start; overflow-x:auto !important; overflow-y:hidden !important; white-space:nowrap; }
        .v4-masthead-spacer { height:130px !important; }
      }

      @media (max-width:640px) {
        .v4-masthead-top { height:68px; padding:9px 12px; }
        .v4-masthead-top .v4-masthead__inner {
          grid-template-columns:minmax(0,1fr) auto !important;
          gap:8px !important;
        }
        .v4-masthead-top .v4-brand {
          grid-column:1 !important;
          width:auto !important;
          max-width:100%;
          gap:7px !important;
          min-width:0;
        }
        .v4-masthead-top .v4-brand__sun {
          width:32px !important;
          height:32px !important;
          flex:0 0 32px;
        }
        .v4-masthead-top .v4-brand__word {
          font-size:clamp(27px,8.3vw,34px) !important;
          white-space:nowrap;
        }
        .v4-masthead-top .v4-masthead__actions {
          grid-column:2 !important;
          justify-self:end !important;
          width:auto !important;
          gap:5px !important;
          flex:0 0 auto;
        }
        .v4-masthead-top .v4-theme-toggle,
        .v4-masthead-top .v4-login {
          font-size:10px !important;
          line-height:1 !important;
          padding:5px 6px !important;
        }
        .v4-masthead-lower { top:68px; height:50px; padding:0 12px; }
        .v4-masthead-lower .v4-nav { height:50px !important; padding-top:16px !important; gap:22px; }
        .v4-masthead-spacer { height:118px !important; }
      }
    </style>
  </head>
  <body>
    <header class="v4-masthead">
      <div class="v4-masthead-top">
        <div class="v4-masthead__inner">
          <a href="/" class="v4-brand" aria-label="Morgentidende forside">
            <img class="v4-brand__sun" src="/morgentidende-sun.png" alt="" width="64" height="64" />
            <span class="v4-brand__word">Morgentidende</span>
          </a>
          <div class="v4-masthead__actions">
            <button class="v4-theme-toggle" type="button" id="theme-toggle">Mørk/Lys</button>
            <a class="v4-login" href="/login">Login</a>
          </div>
        </div>
      </div>
      <div class="v4-masthead-lower">
        <div class="v4-meta-row">
          <span id="v4-date"></span>
          <span>DANMARKS NYE AVIS</span>
        </div>
        <nav class="v4-nav" aria-label="Hovednavigation">
          <a href="/kategori/indland">Indland</a>
          <a href="/kategori/udland">Udland</a>
          <a href="/kategori/penge">Penge</a>
          <a href="/kategori/kultur">Kultur</a>
          <a href="/kategori/viden">Viden</a>
          <a href="/kategori/liv">Liv</a>
        </nav>
      </div>
    </header>
    <div class="v4-masthead-spacer" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <footer class="v4-footer">
      <div class="v4-footer__inner">
        <a href="/" class="v4-footer__brand">Morgentidende</a>
        <p>© Alt materiale på denne side er omfattet af gældende lov om ophavsret.</p>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const saved = localStorage.getItem('mt-v4-theme');
      if (saved === 'dark' || saved === 'light') root.dataset.theme = saved;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('mt-v4-theme', next);
      });

      const dateEl = document.getElementById('v4-date');
      if (dateEl) {
        dateEl.textContent = new Intl.DateTimeFormat('da-DK', {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
        }).format(new Date()).toUpperCase();
      }

      const lower = document.querySelector('.v4-masthead-lower');
      const topbar = document.querySelector('.v4-masthead-top');
      const brand = document.querySelector('.v4-masthead-top .v4-brand');
      if (lower && topbar) {
        let ticking = false;
        let lowerHeight = lower.getBoundingClientRect().height;
        let scrollDistance = lowerHeight;

        const updateMeasurements = () => {
          lowerHeight = lower.getBoundingClientRect().height;
          if (window.innerWidth <= 640) {
            scrollDistance = 140;
          } else if (window.innerWidth <= 900) {
            scrollDistance = 110;
          } else {
            scrollDistance = lowerHeight;
          }
        };

        const render = () => {
          const progress = Math.min(1, Math.max(0, window.scrollY / scrollDistance));
          const travel = lowerHeight * progress;
          lower.style.transform = `translate3d(0, ${-travel}px, 0)`;
          lower.style.pointerEvents = progress >= .999 ? 'none' : 'auto';

          if (brand) {
            const maxScaleChange = window.innerWidth <= 640 ? 0.06 : 0.12;
            const scale = 1 - (maxScaleChange * progress);
            brand.style.transform = `scale(${scale})`;
          }

          topbar.style.boxShadow = progress > .02
            ? `0 8px 22px rgb(8 14 22 / ${0.16 * progress})`
            : 'none';
          ticking = false;
        };

        const requestRender = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(render);
          }
        };

        const measure = () => {
          updateMeasurements();
          requestRender();
        };

        updateMeasurements();
        render();
        window.addEventListener('scroll', requestRender, { passive:true });
        window.addEventListener('resize', measure, { passive:true });
        window.addEventListener('load', measure, { once:true });
      }

      document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const status = form.querySelector('[data-newsletter-status]');
          if (status) status.textContent = 'Tak – formularen er klar, og tilmeldingen åbner før lanceringen.';
        });
      });
    </script>
  </body>
</html>