---
import '../styles/v4.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const {
  title = 'Morgentidende',
  description = 'Morgentidende – få begge sider af sagen i Danmarks nye avis',
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd
} = Astro.props;

const safeJsonLd = jsonLd
  ? JSON.stringify(jsonLd)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029')
  : null;
---
<!doctype html>
<html lang="da" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {image ? <meta property="og:image" content={image} /> : null}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image ? <meta name="twitter:image" content={image} /> : null}
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="shortcut icon" href="/favicon.ico" />
    {image ? <link rel="preload" as="image" href={image} fetchpriority="high" /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=DM+Sans:wght@400;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
    {safeJsonLd ? <script type="application/ld+json" set:html={safeJsonLd} /> : null}
  </head>
  <body>
    <header class="v4-masthead">
      <div class="v4-masthead-top">
        <div class="v4-masthead__inner">
          <a href="/" class="v4-brand" aria-label="Morgentidende forside">
            <img class="v4-brand__sun" src="/morgentidende-sun.png" alt="" width="64" height="64" />
            <span class="v4-brand__word">Morgentidende</span>
          </a>
          <div class="v4-masthead__actions">
            <button class="v4-theme-toggle" type="button" id="theme-toggle">Mørk/Lys</button>
            <a class="v4-login" href="/login">Login</a>
          </div>
        </div>
      </div>
      <div class="v4-masthead-lower">
        <div class="v4-meta-row">
          <span id="v4-date"></span>
          <span>DANMARKS NYE AVIS</span>
        </div>
        <nav class="v4-nav" aria-label="Hovednavigation">
          <a href="/kategori/indland">Indland</a>
          <a href="/kategori/udland">Udland</a>
          <a href="/kategori/penge">Penge</a>
          <a href="/kategori/kultur">Kultur</a>
          <a href="/kategori/analyse">Analyse</a>
          <a href="/kategori/viden">Viden</a>
          <a href="/kategori/liv">Liv</a>
        </nav>
      </div>
    </header>
    <div class="v4-masthead-spacer" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <footer class="v4-footer">
      <div class="v4-footer__inner">
        <a href="/" class="v4-footer__brand">Morgentidende</a>
        <p>© Alt materiale på denne side er omfattet af gældende lov om ophavsret.</p>
      </div>
    </footer>
    <script src="/v4-client.js" defer></script>
  </body>
</html>
