---
import '../styles/v4.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Morgentidende',
  description = 'Morgentidende – få begge sider af sagen i Danmarks nye avis'
} = Astro.props;
---
<!doctype html>
<html lang="da" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="v4-masthead">
      <div class="v4-masthead__inner">
        <a href="/" class="v4-brand" aria-label="Morgentidende forside">
          <img class="v4-brand__sun" src="/morgentidende-sun.png" alt="" width="64" height="64" />
          <span class="v4-brand__word">Morgentidende</span>
        </a>
        <div class="v4-masthead__actions">
          <button class="v4-theme-toggle" type="button" id="theme-toggle">Mørk/Lys</button>
          <a class="v4-login" href="/login">Login</a>
        </div>
      </div>
      <div class="v4-meta-row">
        <span id="v4-date"></span>
        <span>DANMARKS NYE AVIS</span>
      </div>
      <nav class="v4-nav" aria-label="Hovednavigation">
        <a href="/kategori/indland">Indland</a>
        <a href="/kategori/udland">Udland</a>
        <a href="/kategori/penge">Penge</a>
        <a href="/kategori/kultur">Kultur</a>
        <a href="/kategori/viden">Viden</a>
        <a href="/kategori/liv">Liv</a>
      </nav>
    </header>
    <div class="v4-masthead-spacer" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <footer class="v4-footer">
      <div class="v4-footer__inner">
        <a href="/" class="v4-footer__brand">Morgentidende</a>
        <p>© Alt materiale på denne side er omfattet af gældende lov om ophavsret.</p>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const saved = localStorage.getItem('mt-v4-theme');
      if (saved === 'dark' || saved === 'light') root.dataset.theme = saved;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('mt-v4-theme', next);
      });

      const dateEl = document.getElementById('v4-date');
      if (dateEl) {
        dateEl.textContent = new Intl.DateTimeFormat('da-DK', {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
        }).format(new Date()).toUpperCase();
      }

      const masthead = document.querySelector('.v4-masthead');
      const mastheadInner = document.querySelector('.v4-masthead__inner');
      const mastheadSpacer = document.querySelector('.v4-masthead-spacer');
      const metaRow = document.querySelector('.v4-meta-row');
      const nav = document.querySelector('.v4-nav');
      const brand = document.querySelector('.v4-brand');

      if (masthead && mastheadInner && mastheadSpacer && nav) {
        let maxTravel = 120;
        let ticking = false;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        masthead.style.setProperty('--v4-masthead-progress', '0');
        masthead.style.willChange = 'clip-path';
        nav.style.willChange = 'transform';
        if (metaRow) metaRow.style.willChange = 'transform';
        mastheadInner.style.willChange = 'transform';
        if (brand) brand.style.willChange = 'transform';

        const renderMasthead = () => {
          const rawTravel = Math.min(maxTravel, Math.max(0, window.scrollY));
          const travel = reducedMotion.matches && rawTravel > 0 ? maxTravel : rawTravel;
          const progress = maxTravel > 0 ? travel / maxTravel : 1;

          masthead.style.clipPath = `inset(0 0 ${travel}px 0)`;
          nav.style.transform = `translate3d(0, ${-travel}px, 0)`;
          if (metaRow && getComputedStyle(metaRow).display !== 'none') {
            metaRow.style.transform = `translate3d(0, ${-travel}px, 0)`;
          }

          const innerLift = Math.min(18, travel * .16);
          mastheadInner.style.transform = `translate3d(0, ${-innerLift}px, 0)`;
          if (brand) {
            const scale = 1 - (.16 * progress);
            brand.style.transform = `scale(${scale})`;
            brand.style.transformOrigin = window.innerWidth <= 900 ? 'left center' : 'center center';
          }

          nav.style.pointerEvents = progress >= .995 ? 'none' : '';
          ticking = false;
        };

        const requestRender = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(renderMasthead);
          }
        };

        const measureMasthead = () => {
          masthead.style.clipPath = 'none';
          nav.style.transform = 'none';
          if (metaRow) metaRow.style.transform = 'none';
          mastheadInner.style.transform = 'none';
          if (brand) brand.style.transform = 'none';

          const expandedHeight = masthead.getBoundingClientRect().height;
          const innerRect = mastheadInner.getBoundingClientRect();
          const mastheadRect = masthead.getBoundingClientRect();
          const styles = getComputedStyle(masthead);
          const bottomPadding = parseFloat(styles.paddingBottom) || 0;
          const compactHeight = Math.ceil(innerRect.bottom - mastheadRect.top + bottomPadding);

          maxTravel = Math.max(48, expandedHeight - compactHeight);
          mastheadSpacer.style.height = `${expandedHeight}px`;
          requestRender();
        };

        measureMasthead();
        window.addEventListener('scroll', requestRender, { passive: true });
        window.addEventListener('resize', measureMasthead, { passive: true });
        window.addEventListener('load', measureMasthead, { once: true });
        reducedMotion.addEventListener('change', requestRender);
      }

      document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const status = form.querySelector('[data-newsletter-status]');
          if (status) status.textContent = 'Tak – formularen er klar, og tilmeldingen åbner før lanceringen.';
        });
      });
    </script>
  </body>
</html>
