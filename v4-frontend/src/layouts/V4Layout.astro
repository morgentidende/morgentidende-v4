---
import '../styles/v4.css';
import '../styles/footer-newsletter.css';
import '../styles/analytics-consent.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const {
  title = 'Morgentidende',
  description = 'Morgentidende – få begge sider af sagen i Danmarks nye avis',
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd
} = Astro.props;

const siteBase = Astro.site || new URL('https://morgentidende.dk');
const canonicalUrl = canonical || new URL(`${Astro.url.pathname}${Astro.url.search}`, siteBase).toString();
const imageUrl = image ? new URL(image, siteBase).toString() : undefined;

const safeJsonLd = jsonLd
  ? JSON.stringify(jsonLd)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029')
  : null;
---
<!doctype html>
<html lang="da" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline src="/v4-theme-init.js"></script>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="max-image-preview:large" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl ? <meta property="og:image" content={imageUrl} /> : null}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="shortcut icon" href="/favicon.ico" />
    {imageUrl ? <link rel="preload" as="image" href={imageUrl} fetchpriority="high" /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=DM+Sans:wght@400;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
    <style is:inline>
      @media (max-width: 640px) {
        .v4-nav {
          justify-content: center !important;
          gap: clamp(16px, 4vw, 28px) !important;
          overflow-x: hidden !important;
          width: 100%;
        }
      }
    </style>
    {safeJsonLd ? <script type="application/ld+json" set:html={safeJsonLd} /> : null}
  </head>
  <body>
    <header class="v4-masthead">
      <div class="v4-masthead-top">
        <div class="v4-masthead__inner">
          <a href="/" class="v4-brand" aria-label="Morgentidende forside">
            <img class="v4-brand__sun" src="/morgentidende-sun.png" alt="" width="64" height="64" />
            <span class="v4-brand__word">Morgentidende</span>
          </a>
          <div class="v4-masthead__actions">
            <a class="v4-login v4-search-action" href="/soeg" aria-label="Søg i Morgentidende" title="Søg">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
            </a>
            <button class="v4-theme-toggle" type="button" id="theme-toggle">Mørk/Lys</button>
          </div>
        </div>
      </div>
      <div class="v4-masthead-lower">
        <div class="v4-meta-row">
          <span id="v4-date"></span>
          <span>DANMARKS NYE AVIS</span>
        </div>
        <nav class="v4-nav" aria-label="Hovednavigation">
          <a href="/kategori/indland">Indland</a>
          <a href="/kategori/udland">Udland</a>
          <a href="/kategori/penge">Penge</a>
          <a href="/kategori/kultur">Kultur</a>
          <a href="/kategori/tema">Tema</a>
          <a href="/kategori/viden">Viden</a>
          <a href="/kategori/liv">Liv</a>
        </nav>
      </div>
    </header>
    <div class="v4-masthead-spacer" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <footer class="v4-footer">
      <div class="v4-footer__inner">
        <div class="v4-footer__newsletter">
          <div class="v4-footer__newsletter-copy">Få Morgentidende på mail</div>
          <form class="v4-footer__newsletter-form" data-newsletter-form>
            <input id="footer-newsletter-email" name="email" type="email" autocomplete="email" placeholder="Din e-mail" aria-label="Din e-mail" required />
            <input type="hidden" name="delivery_time" value="06:00" />
            <input type="hidden" name="newsletter" value="daily" />
            <button type="submit">Tilmeld</button>
            <p class="v4-footer__newsletter-status" data-newsletter-status aria-live="polite"></p>
            <p class="v4-footer__newsletter-note">Bekræftelse kræves. Nyhedsbrevet kan indeholde annoncer og affiliate-links. Du kan altid afmelde dig. <a href="/privatliv">Læs om privatliv.</a></p>
          </form>
        </div>

        <div class="v4-footer__main">
          <a href="/" class="v4-footer__brand">Morgentidende</a>

          <nav class="v4-footer__links" aria-label="Om Morgentidende">
            <div class="v4-footer__link-group">
              <div class="v4-footer__link-title">Morgentidende</div>
              <a href="/om-morgentidende">Om Morgentidende</a>
              <a href="/redaktionelle-principper">Redaktionelle principper</a>
              <a href="/kontakt">Kontakt</a>
              <a href="/stoet-morgentidende">Støt os</a>
              <a href="/privatliv">Privatliv</a>
              <button class="v4-footer__analytics-settings" type="button" data-analytics-settings>Cookievalg</button>
            </div>

            <div class="v4-footer__link-group">
              <div class="v4-footer__link-title">Sektioner</div>
              <a href="/kategori/indland">Indland</a>
              <a href="/kategori/udland">Udland</a>
              <a href="/kategori/penge">Penge</a>
              <a href="/kategori/kultur">Kultur</a>
              <a href="/kategori/tema">Tema</a>
              <a href="/kategori/viden">Viden</a>
              <a href="/kategori/liv">Liv</a>
            </div>
          </nav>
        </div>

        <div class="v4-footer__legal">
          <p>© Alt materiale på denne side er omfattet af gældende lov om ophavsret.</p>
        </div>
      </div>
    </footer>

    <aside class="analytics-consent" data-analytics-consent hidden aria-label="Valg af statistikcookies">
      <div class="analytics-consent__inner">
        <p class="analytics-consent__copy">Vil du acceptere cookies?</p>
        <div class="analytics-consent__actions">
          <button class="analytics-consent__button" type="button" data-analytics-reject>Afvis</button>
          <button class="analytics-consent__button analytics-consent__button--accept" type="button" data-analytics-accept>Accepter</button>
        </div>
      </div>
    </aside>

    <script src="/v4-client.js" defer></script>
    <script src="/ga4-consent.js" defer></script>
  </body>
</html>