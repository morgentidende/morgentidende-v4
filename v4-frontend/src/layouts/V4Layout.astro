---
import '../styles/v4.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Morgentidende',
  description = 'Morgentidende – få begge sider af sagen i Danmarks nye avis'
} = Astro.props;
---
<!doctype html>
<html lang="da" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="v4-masthead">
      <div class="v4-masthead__inner">
        <a href="/" class="v4-brand" aria-label="Morgentidende forside">
          <img class="v4-brand__sun" src="/morgentidende-sun.png" alt="" width="64" height="64" />
          <span class="v4-brand__word">Morgentidende</span>
        </a>
        <div class="v4-masthead__actions">
          <button class="v4-theme-toggle" type="button" id="theme-toggle">Mørk/Lys</button>
          <a class="v4-login" href="/login">Login</a>
        </div>
      </div>
      <div class="v4-meta-row">
        <span id="v4-date"></span>
        <span>DANMARKS NYE AVIS</span>
      </div>
      <nav class="v4-nav" aria-label="Hovednavigation">
        <a href="/kategori/indland">Indland</a>
        <a href="/kategori/udland">Udland</a>
        <a href="/kategori/penge">Penge</a>
        <a href="/kategori/kultur">Kultur</a>
        <a href="/kategori/viden">Viden</a>
        <a href="/kategori/liv">Liv</a>
      </nav>
    </header>
    <div class="v4-masthead-spacer" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <footer class="v4-footer">
      <div class="v4-footer__inner">
        <a href="/" class="v4-footer__brand">Morgentidende</a>
        <p>© Alt materiale på denne side er omfattet af gældende lov om ophavsret.</p>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const saved = localStorage.getItem('mt-v4-theme');
      if (saved === 'dark' || saved === 'light') root.dataset.theme = saved;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('mt-v4-theme', next);
      });
      const dateEl = document.getElementById('v4-date');
      if (dateEl) {
        dateEl.textContent = new Intl.DateTimeFormat('da-DK', {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
        }).format(new Date()).toUpperCase();
      }
      const masthead = document.querySelector('.v4-masthead');
      const mastheadSpacer = document.querySelector('.v4-masthead-spacer');
      if (masthead && mastheadSpacer) {
        let collapseDistance = 240;
        let currentProgress = 0;
        let targetProgress = 0;
        let animationFrame = 0;
        let previousTime = 0;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const renderMasthead = (progress) => {
          masthead.style.setProperty('--v4-masthead-progress', progress.toFixed(4));
          masthead.classList.toggle('is-compact', progress >= .999);
        };

        const animateMasthead = (time) => {
          const elapsed = previousTime ? Math.min(50, time - previousTime) : 16;
          previousTime = time;
          const blend = 1 - Math.exp(-elapsed / 145);
          currentProgress += (targetProgress - currentProgress) * blend;

          if (Math.abs(targetProgress - currentProgress) < .001) {
            currentProgress = targetProgress;
            renderMasthead(currentProgress);
            animationFrame = 0;
            previousTime = 0;
            return;
          }

          renderMasthead(currentProgress);
          animationFrame = window.requestAnimationFrame(animateMasthead);
        };

        const updateMastheadTarget = () => {
          const rawProgress = Math.min(1, Math.max(0, window.scrollY / collapseDistance));
          targetProgress = reducedMotion.matches && rawProgress > 0 ? 1 : rawProgress;

          if (reducedMotion.matches) {
            if (animationFrame) window.cancelAnimationFrame(animationFrame);
            animationFrame = 0;
            previousTime = 0;
            currentProgress = targetProgress;
            renderMasthead(currentProgress);
          } else if (!animationFrame) {
            animationFrame = window.requestAnimationFrame(animateMasthead);
          }
        };

        const measureMasthead = () => {
          if (animationFrame) window.cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          previousTime = 0;
          renderMasthead(0);
          const expandedHeight = masthead.offsetHeight;
          const minimumDistance = window.innerWidth <= 640 ? 190 : window.innerWidth <= 900 ? 210 : 240;
          collapseDistance = Math.max(minimumDistance, expandedHeight * .9);
          mastheadSpacer.style.height = `${expandedHeight}px`;
          const rawProgress = Math.min(1, Math.max(0, window.scrollY / collapseDistance));
          targetProgress = reducedMotion.matches && rawProgress > 0 ? 1 : rawProgress;
          currentProgress = targetProgress;
          renderMasthead(currentProgress);
        };

        measureMasthead();
        window.addEventListener('scroll', updateMastheadTarget, { passive: true });
        window.addEventListener('load', measureMasthead, { once: true });
        window.addEventListener('resize', measureMasthead, { passive: true });
        reducedMotion.addEventListener('change', updateMastheadTarget);
      }
      document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const status = form.querySelector('[data-newsletter-status]');
          if (status) status.textContent = 'Tak – formularen er klar, og tilmeldingen åbner før lanceringen.';
        });
      });
    </script>
  </body>
</html>
