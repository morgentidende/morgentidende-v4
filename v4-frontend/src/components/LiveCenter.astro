---
import V4Card from './V4Card.astro';

const { center, updates = [], relatedArticles = [], categoryById = new Map() } = Astro.props;
const metrics = center?.metrics && Object.keys(center.metrics).length
  ? center.metrics
  : (center?.result_data || {});
const renderer = center?.renderer || (Array.isArray(metrics.parties) ? 'election_table' : 'headline_only');
const ui = {
  feed_kicker: 'LIVE',
  feed_title: 'Seneste udvikling',
  metrics_kicker: 'STATUS',
  metrics_title: 'Lige nu',
  followups_label: 'Baggrund',
  expand_open: 'Læs hele opdateringen',
  expand_close: 'Skjul opdateringen',
  ...(center?.ui || {}),
};
const parties = Array.isArray(metrics.parties) ? metrics.parties : [];
const blocks = Array.isArray(metrics.blocks) ? metrics.blocks : [];
const visibleUpdates = updates.slice(0, 2);
const olderUpdates = updates.slice(2);
const followups = relatedArticles.slice(0, 3);

const fmtTime = (value) => value
  ? new Intl.DateTimeFormat('da-DK', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Copenhagen',
    }).format(new Date(value)).replace(':', '.')
  : null;

const fmtNumber = (value) => typeof value === 'number'
  ? new Intl.NumberFormat('da-DK').format(value)
  : null;

const metricsUpdatedAt = fmtTime(center?.metrics_updated_at || center?.result_updated_at);
const sourceName = center?.source_name || String(center?.source_label || '').split(/\r?\n/)[0] || null;
const sourceUrl = center?.source_url || null;
const statHeadline = metrics.counted_label || metrics.headline || null;
const statSubheadline = metrics.subheadline || null;

const generatedStats = [
  ['Omkomne', fmtNumber(metrics.deaths_found ?? metrics.dead)],
  ['Savnede', fmtNumber(metrics.missing)],
  ['Sårede', fmtNumber(metrics.injured)],
  ['Reddede', fmtNumber(metrics.rescued)],
].filter(([, value]) => value !== null);
---

<section class="livecenter" aria-labelledby="livecenter-title" data-kind={center?.kind || 'generic'} data-renderer={renderer}>
  <header class="livecenter__header">
    <div class="livecenter__eyebrow">
      <span class="livecenter__dot" aria-hidden="true"></span>{center.label}
    </div>
    <h1 id="livecenter-title" class="livecenter__title">{center.title}</h1>
    {center.deck ? <p class="livecenter__deck">{center.deck}</p> : null}
  </header>

  <div class="livecenter__grid">
    <section class="livecenter__panel livecenter__feed" aria-labelledby="livecenter-feed-title">
      <div class="livecenter__section-head">
        <div>
          <div class="livecenter__section-kicker">{ui.feed_kicker}</div>
          <h2 id="livecenter-feed-title">{ui.feed_title}</h2>
        </div>
      </div>

      <div class="livecenter__updates">
        {visibleUpdates.map((update, index) => (
          <article class:list={['livecenter__update', index === 0 && 'livecenter__update--latest']}>
            <time datetime={update.published_at}>{fmtTime(update.published_at)}</time>
            <details class="livecenter__update-details">
              <summary>
                <h3>{update.headline}</h3>
                <p class="livecenter__update-teaser">{update.body}</p>
                <span class="livecenter__update-toggle livecenter__update-toggle--open">
                  {ui.expand_open}<span aria-hidden="true">↓</span>
                </span>
              </summary>
              <div class="livecenter__update-full">
                <p>{update.body}</p>
                <span class="livecenter__update-toggle livecenter__update-toggle--close">
                  {ui.expand_close}<span aria-hidden="true">↑</span>
                </span>
              </div>
            </details>
          </article>
        ))}
      </div>

      {olderUpdates.length ? (
        <details class="livecenter__archive">
          <summary>Se alle opdateringer <span aria-hidden="true">↓</span></summary>
          <div class="livecenter__archive-list">
            {olderUpdates.map((update) => (
              <article class="livecenter__update livecenter__update--archive">
                <time datetime={update.published_at}>{fmtTime(update.published_at)}</time>
                <div>
                  <h3>{update.headline}</h3>
                  <p>{update.body}</p>
                </div>
              </article>
            ))}
          </div>
        </details>
      ) : null}
    </section>

    <aside class="livecenter__panel livecenter__results" aria-labelledby="livecenter-results-title">
      <div class="livecenter__section-head">
        <div>
          <div class="livecenter__section-kicker livecenter__section-kicker--results">{ui.metrics_kicker}</div>
          <h2 id="livecenter-results-title">{ui.metrics_title}</h2>
        </div>
      </div>

      {renderer === 'election_table' ? (
        <>
          <div class="livecenter__result-status">
            {typeof metrics.counted_pct === 'number' && metrics.counted_pct > 0
              ? <div class="livecenter__big-number">{metrics.counted_pct}<span>%</span></div>
              : null}
            <div>
              <strong>{metrics.counted_label || metrics.headline || 'Afventer optælling'}</strong>
              {metrics.subheadline ? <p>{metrics.subheadline}</p> : null}
            </div>
          </div>

          {parties.length ? (
            <div class="livecenter__party-table" role="table" aria-label="Partiernes resultat">
              {parties.map((party) => (
                <div class="livecenter__party-row" role="row">
                  <strong role="cell">{party.name}</strong>
                  <span role="cell">{party.percent}%</span>
                  <span role="cell" class:list={[
                    'livecenter__change',
                    party.change > 0 ? 'is-up' : party.change < 0 ? 'is-down' : '',
                  ]}>
                    {party.change > 0 ? '+' : ''}{party.change ?? ''}
                  </span>
                </div>
              ))}
            </div>
          ) : null}

          {blocks.length ? (
            <div class="livecenter__blocks">
              <div class="livecenter__blocks-title">Mandater</div>
              {blocks.map((block) => (
                <div class="livecenter__block-row">
                  <span>{block.name}</span><strong>{block.seats}</strong>
                </div>
              ))}
              {metrics.block_summary ? <div class="livecenter__block-summary">{metrics.block_summary}</div> : null}
            </div>
          ) : null}
        </>
      ) : renderer === 'stat_list' ? (
        <div class="livecenter__result-status livecenter__result-status--stats">
          {statHeadline ? <strong>{statHeadline}</strong> : null}
          {statSubheadline ? <p>{statSubheadline}</p> : null}
          {!statHeadline && generatedStats.length ? (
            <dl class="livecenter__stat-list">
              {generatedStats.map(([label, value]) => (
                <div class="livecenter__stat-row"><dt>{label}</dt><dd>{value}</dd></div>
              ))}
            </dl>
          ) : null}
        </div>
      ) : (
        <div class="livecenter__result-status">
          <div>
            <strong>{metrics.headline || metrics.counted_label || 'Status følger'}</strong>
            {metrics.subheadline ? <p>{metrics.subheadline}</p> : null}
          </div>
        </div>
      )}

      <div class="livecenter__source" aria-label="Kilde og seneste opdatering">
        {sourceName ? (
          <div class="livecenter__source-line">
            <span>Kilde: </span>{sourceUrl ? <a href={sourceUrl} rel="noopener noreferrer">{sourceName}</a> : <span>{sourceName}</span>}
          </div>
        ) : null}
        {metricsUpdatedAt ? <div class="livecenter__source-line">Opdateret {metricsUpdatedAt}</div> : null}
      </div>
    </aside>
  </div>

  {updates.length === 0 && center.key_points?.length ? (
    <section class="livecenter__keypoints" aria-labelledby="livecenter-keypoints-title">
      <div id="livecenter-keypoints-title" class="livecenter__keypoints-title">Vigtigst lige nu</div>
      <ul>{center.key_points.slice(0, 3).map((point) => <li>{point}</li>)}</ul>
    </section>
  ) : null}

  {followups.length ? (
    <div class="livecenter__followups">
      <div class="livecenter__followups-label">{ui.followups_label}</div>
      <div class="livecenter__followups-grid">
        {followups.map((article) => (
          <V4Card
            article={article}
            categoryName={categoryById.get(article.category_id)}
            showDeck={false}
          />
        ))}
      </div>
    </div>
  ) : null}
</section>

<style>
  .livecenter {
    margin: 18px 0 30px;
    border: 1px solid color-mix(in srgb, var(--v4-accent, #d6a72f) 34%, var(--v4-rule));
    border-top: 5px solid var(--v4-accent, #d6a72f);
    padding: 22px 24px 24px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--v4-accent, #d6a72f) 4%, transparent), transparent 42%), color-mix(in srgb, var(--v4-text) 1.2%, transparent);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--v4-text) 6%, transparent);
  }
  .livecenter__header { max-width: 980px; margin-bottom: 20px; }
  .livecenter__eyebrow { display:inline-flex; align-items:center; gap:8px; margin-bottom:9px; padding:5px 9px 4px; border:1px solid color-mix(in srgb,var(--v4-accent,#d6a72f) 55%,var(--v4-rule)); background:color-mix(in srgb,var(--v4-accent,#d6a72f) 10%,transparent); font-size:11px; font-weight:900; letter-spacing:.09em; text-transform:uppercase; color:var(--v4-accent,#d6a72f); }
  .livecenter__dot { width:7px; height:7px; border-radius:50%; background:currentColor; box-shadow:0 0 0 3px color-mix(in srgb,currentColor 15%,transparent); }
  .livecenter__title { max-width:900px; margin:0; font-family:var(--v4-serif); font-size:clamp(34px,4vw,54px); line-height:.99; letter-spacing:-.033em; }
  .livecenter__deck { max-width:820px; margin:9px 0 0; font-family:var(--v4-serif); font-size:clamp(16px,1.35vw,19px); line-height:1.4; color:var(--v4-muted); }
  .livecenter__grid { display:grid; grid-template-columns:minmax(0,1.16fr) minmax(300px,.84fr); gap:22px; align-items:stretch; }
  .livecenter__panel { min-width:0; margin:0; padding:16px 18px 15px; border:1px solid color-mix(in srgb,var(--v4-accent,#d6a72f) 32%,var(--v4-rule)); border-top:3px solid var(--v4-accent,#d6a72f); background:color-mix(in srgb,var(--v4-accent,#d6a72f) 4.5%,transparent); display:flex; flex-direction:column; }
  .livecenter__section-head { min-height:calc(10px * 1.2 + 4px + clamp(24px,2vw,31px)); margin-bottom:10px; display:flex; align-items:flex-start; }
  .livecenter__section-head > div { width:100%; }
  .livecenter__section-kicker { margin-bottom:4px; font-size:10px; line-height:1.2; font-weight:900; letter-spacing:.12em; color:#c7362f; }
  .livecenter__section-kicker--results { color:var(--v4-accent,#d6a72f); }
  .livecenter__section-head h2 { margin:0; font-family:var(--v4-serif); font-size:clamp(24px,2vw,31px); line-height:1; }
  .livecenter__updates { border-top:2px solid var(--v4-text); }
  .livecenter__update { display:grid; grid-template-columns:48px minmax(0,1fr); gap:11px; padding:12px 0; border-top:1px solid var(--v4-rule); }
  .livecenter__update:first-child { border-top:0; }
  .livecenter__update time { padding-top:2px; font-variant-numeric:tabular-nums; font-size:11px; font-weight:900; color:var(--v4-muted); }
  .livecenter__update h3 { margin:0 0 4px; font-family:var(--v4-serif); font-size:19px; line-height:1.08; }
  .livecenter__update--latest h3 { font-size:clamp(21px,1.75vw,25px); }
  .livecenter__update p { margin:0; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; font-size:13px; line-height:1.42; color:var(--v4-muted); }
  .livecenter__update:not(.livecenter__update--latest):not(.livecenter__update--archive) p { -webkit-line-clamp:2; }
  .livecenter__update-details { min-width:0; }
  .livecenter__update-details summary { cursor:pointer; list-style:none; }
  .livecenter__update-details summary::-webkit-details-marker { display:none; }
  .livecenter__update-toggle { display:inline-flex; align-items:center; gap:5px; margin-top:6px; font-size:11px; font-weight:800; color:var(--v4-text); }
  .livecenter__update-toggle--close { margin-top:8px; }
  .livecenter__update-details[open] .livecenter__update-teaser, .livecenter__update-details[open] .livecenter__update-toggle--open { display:none; }
  .livecenter__update-full { padding-top:7px; }
  .livecenter__update-full p { display:block; -webkit-line-clamp:unset; overflow:visible; color:var(--v4-text); }
  .livecenter__archive { margin-top:auto; border-top:1px solid var(--v4-rule); }
  .livecenter__archive summary { cursor:pointer; list-style:none; padding:11px 0 1px; font-size:12px; font-weight:900; color:var(--v4-text); }
  .livecenter__archive summary::-webkit-details-marker { display:none; }
  .livecenter__archive-list { padding-top:6px; }
  .livecenter__update--archive { padding:11px 0; }
  .livecenter__update--archive h3 { font-size:18px; }
  .livecenter__update--archive p { -webkit-line-clamp:unset; overflow:visible; }
  .livecenter__result-status { display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:center; padding:12px 0 14px; border-top:2px solid var(--v4-text); }
  .livecenter__result-status--stats { display:block; }
  .livecenter__big-number { font-family:var(--v4-serif); font-size:clamp(48px,5.2vw,70px); font-weight:700; line-height:.82; letter-spacing:-.06em; }
  .livecenter__big-number span { margin-left:2px; font-size:.38em; }
  .livecenter__result-status strong { display:block; font-family:var(--v4-serif); font-size:clamp(20px,1.75vw,26px); line-height:1.04; }
  .livecenter__result-status p { margin:6px 0 0; font-size:13px; line-height:1.42; color:var(--v4-muted); }
  .livecenter__stat-list { margin:0; }
  .livecenter__stat-row { display:flex; justify-content:space-between; gap:16px; padding:7px 0; border-bottom:1px solid var(--v4-rule); }
  .livecenter__stat-row dt { color:var(--v4-muted); }
  .livecenter__stat-row dd { margin:0; font-weight:850; font-variant-numeric:tabular-nums; }
  .livecenter__party-table { margin-top:12px; }
  .livecenter__party-row { display:grid; grid-template-columns:1fr 62px 52px; gap:8px; padding:7px 0; border-bottom:1px solid var(--v4-rule); font-size:14px; font-variant-numeric:tabular-nums; }
  .livecenter__party-row span { text-align:right; }
  .livecenter__change { color:var(--v4-muted); }
  .livecenter__blocks { margin-top:14px; padding-top:11px; border-top:1px solid var(--v4-text); }
  .livecenter__blocks-title { margin-bottom:5px; font-size:10px; font-weight:900; letter-spacing:.09em; text-transform:uppercase; }
  .livecenter__block-row { display:flex; justify-content:space-between; align-items:baseline; gap:16px; padding:5px 0; font-size:14px; line-height:1.25; }
  .livecenter__block-row strong { font-size:14px; font-weight:850; font-variant-numeric:tabular-nums; }
  .livecenter__block-summary { margin-top:7px; padding-top:7px; border-top:1px solid var(--v4-rule); font-size:13px; line-height:1.38; font-weight:700; color:var(--v4-muted); }
  .livecenter__source { margin-top:auto; padding-top:10px; border-top:1px solid var(--v4-rule); font-size:13px; line-height:1.42; color:var(--v4-muted); }
  .livecenter__source-line { display:block; }
  .livecenter__source a { color:inherit; text-decoration:underline; text-underline-offset:2px; }
  .livecenter__keypoints { display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:start; margin-top:14px; padding:10px 12px; border-top:1px solid color-mix(in srgb,var(--v4-accent,#d6a72f) 45%,var(--v4-rule)); border-bottom:1px solid color-mix(in srgb,var(--v4-accent,#d6a72f) 45%,var(--v4-rule)); background:color-mix(in srgb,var(--v4-accent,#d6a72f) 5%,transparent); }
  .livecenter__keypoints-title { padding-top:2px; white-space:nowrap; font-size:10px; font-weight:900; letter-spacing:.09em; text-transform:uppercase; color:var(--v4-accent,#d6a72f); }
  .livecenter__keypoints ul { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin:0; padding:0; list-style:none; font-size:12px; line-height:1.32; }
  .livecenter__keypoints li { position:relative; padding-left:11px; }
  .livecenter__keypoints li::before { content:'•'; position:absolute; left:0; color:var(--v4-accent,#d6a72f); }
  .livecenter__followups { margin-top:18px; padding-top:14px; border-top:1px solid color-mix(in srgb,var(--v4-accent,#d6a72f) 34%,var(--v4-rule)); }
  .livecenter__followups-label { margin-bottom:10px; font-size:10px; font-weight:900; letter-spacing:.1em; text-transform:uppercase; color:var(--v4-accent,#d6a72f); }
  .livecenter__followups-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .livecenter__followups-grid :global(.v4-card__headline) { font-size:clamp(18px,1.45vw,24px); }
  @media (max-width:780px) {
    .livecenter { margin-top:12px; padding:17px 14px 20px; }
    .livecenter__header { margin-bottom:17px; }
    .livecenter__title { font-size:clamp(32px,9.2vw,42px); }
    .livecenter__deck { font-size:15px; }
    .livecenter__grid { display:flex; flex-direction:column; gap:15px; }
    .livecenter__results { order:-1; width:100%; padding:15px 14px 14px; }
    .livecenter__feed { width:100%; padding:15px 14px 13px; }
    .livecenter__update { grid-template-columns:43px minmax(0,1fr); gap:8px; padding:11px 0; }
    .livecenter__update--latest h3 { font-size:21px; }
    .livecenter__update h3 { font-size:18px; }
    .livecenter__update p, .livecenter__result-status p, .livecenter__source { font-size:12.5px; line-height:1.4; }
    .livecenter__keypoints { grid-template-columns:1fr; gap:7px; margin-top:12px; }
    .livecenter__keypoints ul { grid-template-columns:1fr; gap:5px; }
    .livecenter__followups-grid { grid-template-columns:1fr; gap:15px; }
  }
</style>
