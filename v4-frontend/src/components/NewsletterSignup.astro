---
interface Props {
  variant?: 'daily' | 'weekly';
  magazineName?: 'Viden' | 'Liv';
}

const { variant = 'daily', magazineName = 'Viden' } = Astro.props;
const isWeekly = variant === 'weekly';
const title = isWeekly ? `Ugens bedste fra ${magazineName}` : 'Start dagen med Morgentidende';
const description = isWeekly
  ? `Hver søndag kl. 06 samler vi ugens mest spændende artikler fra ${magazineName} i én rolig udgave.`
  : 'Dagens vigtigste historier – kort og klart i din indbakke hver morgen kl. 06.';
---
<aside class:list={['v4-newsletter', !isWeekly && 'v4-newsletter--daily', isWeekly && 'v4-newsletter--weekly']} aria-label={title}>
  <div class="v4-newsletter__copy">
    <div class="v4-kicker">{isWeekly ? `${magazineName} på mail` : 'Dagligt nyhedsbrev'}</div>
    <h2>{title}</h2>
    <p>{description}</p>
    {isWeekly ? (
      <p class="v4-newsletter__formats">Læs direkte i indbakken · Åbn magasinet på nettet · Hent som PDF til din e-reader</p>
    ) : null}
  </div>
  <form class="v4-newsletter-form" data-newsletter-form>
    <label for={`newsletter-email-${variant}-${magazineName}`}>Din e-mail</label>
    <div class="v4-newsletter-form__row">
      <input id={`newsletter-email-${variant}-${magazineName}`} name="email" type="email" autocomplete="email" placeholder="navn@eksempel.dk" required />
      <button type="submit">{isWeekly ? 'Skriv mig på listen' : 'Tilmeld'}</button>
    </div>
    <input type="hidden" name="delivery_time" value={isWeekly ? 'Sunday 06:00' : '06:00'} />
    <input type="hidden" name="newsletter" value={isWeekly ? magazineName.toLowerCase() : 'daily'} />
    {!isWeekly ? (
      <p class="v4-newsletter-form__note">
        Bekræft din e-mail – så er du med. Afmeld når som helst.
      </p>
    ) : (
      <p class="v4-newsletter-form__note">Viden og Liv får deres egne magasinnyhedsbreve. Tilmeldingen åbner senere.</p>
    )}
    <p class="v4-newsletter-form__status" data-newsletter-status aria-live="polite"></p>
  </form>
</aside>

<style>
  .v4-newsletter--daily {
    padding: clamp(22px, 3.2vw, 32px);
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
    gap: clamp(28px, 4.5vw, 52px);
    align-items: center;
  }

  .v4-newsletter--daily .v4-newsletter__copy,
  .v4-newsletter--daily .v4-newsletter-form {
    min-width: 0;
  }

  .v4-newsletter--daily .v4-newsletter__copy h2 {
    margin: 5px 0 8px;
    font-size: clamp(28px, 2.8vw, 39px);
    line-height: 1.04;
  }

  .v4-newsletter--daily .v4-newsletter__copy > p {
    max-width: 560px;
    line-height: 1.42;
  }

  .v4-newsletter--daily .v4-kicker {
    font-size: 11px;
    opacity: .88;
  }

  .v4-newsletter--daily .v4-newsletter-form > label {
    margin-bottom: 7px;
    font-size: 13px;
  }

  .v4-newsletter--daily .v4-newsletter-form__row {
    gap: 10px;
  }

  .v4-newsletter--daily .v4-newsletter-form input[type='email'] {
    min-height: 50px;
    padding: 13px 14px;
    font-size: 16px;
  }

  .v4-newsletter--daily .v4-newsletter-form button {
    min-height: 50px;
    padding: 12px 22px;
    min-width: 92px;
  }

  .v4-newsletter--daily .v4-newsletter-form__note {
    margin: 9px 0 0;
    font-size: 11px;
    line-height: 1.4;
    opacity: .66;
  }

  .v4-newsletter--daily .v4-newsletter-form__status {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .v4-newsletter--daily {
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
      padding: 22px 18px;
      gap: 20px;
    }

    .v4-newsletter--daily .v4-newsletter__copy h2 {
      margin-top: 7px;
      max-width: none;
      font-size: clamp(28px, 8vw, 34px);
      line-height: 1.08;
    }

    .v4-newsletter--daily .v4-newsletter__copy > p {
      max-width: none;
      font-size: 16px;
      line-height: 1.45;
    }

    .v4-newsletter--daily .v4-newsletter-form,
    .v4-newsletter--daily .v4-newsletter-form__row {
      width: 100%;
    }

    .v4-newsletter--daily .v4-newsletter-form__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .v4-newsletter--daily .v4-newsletter-form input[type='email'],
    .v4-newsletter--daily .v4-newsletter-form button {
      width: 100%;
      min-width: 0;
      min-height: 48px;
    }

    .v4-newsletter--daily .v4-newsletter-form__note {
      margin-bottom: 0;
    }
  }
</style>
