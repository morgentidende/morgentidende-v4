---
import '../styles/story-related.css';
import { responsiveImage } from '../lib/media';

interface Props {
  article: any;
  categoryName?: string;
  showDeck?: boolean;
  imageLoading?: 'eager' | 'lazy';
  imageFetchPriority?: 'high' | 'low' | 'auto';
  imageSizes?: string;
  cardClass?: string;
}
const {
  article,
  categoryName,
  showDeck = true,
  imageLoading = 'lazy',
  imageFetchPriority = 'auto',
  imageSizes = '(max-width: 640px) calc(100vw - 28px), (max-width: 900px) 50vw, 25vw',
  cardClass = ''
} = Astro.props;
const headline = article.frontpage_headline || article.headline;
const accent = article.headline_accent_text?.trim();
const hero = responsiveImage(article.hero_url, [320, 480, 640, 960, 1280]);
let before = headline;
let highlighted = '';
let after = '';
if (accent) {
  const index = headline.toLocaleLowerCase('da-DK').indexOf(accent.toLocaleLowerCase('da-DK'));
  if (index >= 0) {
    before = headline.slice(0, index);
    highlighted = headline.slice(index, index + accent.length);
    after = headline.slice(index + accent.length);
  }
}
---
<article class:list={['v4-card', cardClass]}>
  <a class="v4-card__media" href={`/artikel/${article.slug}`}>
    {article.hero_url ? (
      <img
        src={hero.src}
        srcset={hero.srcset}
        sizes={hero.srcset ? imageSizes : undefined}
        alt={article.hero_alt || ''}
        loading={imageLoading}
        fetchpriority={imageFetchPriority}
        decoding="async"
        width="1200"
        height="800"
        onerror="this.onerror=null;this.removeAttribute('srcset');this.style.display='none';this.parentElement.classList.add('v4-card__media--failed')"
      />
    ) : null}
  </a>
  {categoryName ? <div class="v4-kicker">{categoryName}</div> : null}
  <h2 class="v4-card__headline">
    <a href={`/artikel/${article.slug}`}>
      {before}<span class="v4-card__accent">{highlighted}</span>{after}
    </a>
  </h2>
  {showDeck && article.deck ? <p class="v4-card__deck">{article.deck}</p> : null}
</article>

<style>
  .v4-card__media--failed {
    position: relative;
    min-height: 120px;
    background:
      radial-gradient(circle at 24% 30%, rgba(216, 163, 61, .22), transparent 34%),
      linear-gradient(135deg, #172638 0%, #251b2d 100%);
  }

  .v4-card__media--failed::after {
    content: 'Morgentidende';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, .52);
    font-family: var(--v4-serif);
    font-size: clamp(18px, 2vw, 30px);
    letter-spacing: .01em;
  }
</style>
