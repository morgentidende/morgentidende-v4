---
import V4Layout from '../../layouts/V4Layout.astro';
import V4Card from '../../components/V4Card.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { v4Supabase } from '../../lib/v4-supabase';

const { category: categorySlug } = Astro.params;
let category: any = null;
let articles: any[] = [];

if (v4Supabase && categorySlug) {
  const categoryResult = await v4Supabase
    .from('v4_public_categories')
    .select('id,slug,name,description')
    .eq('slug', categorySlug)
    .maybeSingle();

  if (categoryResult.error) {
    console.error('category_query_failed', {
      categorySlug,
      code: categoryResult.error.code,
      message: categoryResult.error.message
    });
  }
  category = categoryResult.data;

  if (category) {
    const articlesResult = await v4Supabase
      .from('v4_public_articles')
      .select('id,slug,headline,frontpage_headline,headline_accent_text,deck,hero_url,hero_alt,published_at')
      .eq('category_id', category.id)
      .order('published_at', { ascending: false })
      .limit(40);

    if (articlesResult.error) {
      console.error('category_articles_query_failed', {
        categorySlug,
        code: articlesResult.error.code,
        message: articlesResult.error.message
      });
    }
    articles = articlesResult.data || [];
  }
}

if (!category) Astro.response.status = 404;
const isMagazine = category?.name === 'Viden' || category?.name === 'Liv';
const canonical = category ? `${Astro.url.origin}/kategori/${category.slug}` : undefined;
const magazineSeo = category?.slug === 'viden'
  ? {
      title: 'Viden: forskning, teknologi og videnskab – Morgentidende',
      description: 'Viden samler forklarende artikler om forskning, teknologi, AI, sundhedsvidenskab, rumfart og nye opdagelser – skrevet til at kunne forstås og bruges.'
    }
  : category?.slug === 'liv'
    ? {
        title: 'Liv: sundhed, psykologi og hverdagsliv – Morgentidende',
        description: 'Liv samler brugbare artikler om sundhed, søvn, træning, psykologi, parforhold, privatøkonomi og et bedre hverdagsliv – med vægt på dokumentation.'
      }
    : null;
const seoTitle = category ? (magazineSeo?.title || `${category.name} – Morgentidende`) : 'Ikke fundet – Morgentidende';
const seoDescription = category ? (magazineSeo?.description || category.description || `Seneste nyt fra ${category.name} på Morgentidende.`) : '';
const categoryJsonLd = category ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: seoTitle,
  description: seoDescription,
  url: canonical,
  inLanguage: 'da-DK',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Morgentidende',
    url: `${Astro.url.origin}/`
  }
} : undefined;
---
<V4Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  noindex={!category}
  jsonLd={categoryJsonLd}
>
  <div class="v4-shell">
    {category ? (
      <>
        <header class:list={['v4-category-header', isMagazine && `v4-category-header--${category.slug}`]}>
          <div class="v4-kicker">{isMagazine ? 'Magasin' : 'Sektion'}</div>
          <h1>{category.name}</h1>
          {category.description ? <p>{category.description}</p> : null}
        </header>
        {articles.length ? (
          <section class="v4-section">
            <div class="v4-grid-3">
              {articles.map((article) => (
                <V4Card
                  article={article}
                  showDeck={true}
                  imageLoading="eager"
                  imageFetchPriority="auto"
                />
              ))}
            </div>
          </section>
        ) : <div class="v4-empty">Der er endnu ingen artikler i denne sektion.</div>}
        {isMagazine ? <NewsletterSignup variant="weekly" magazineName={category.name} /> : null}
      </>
    ) : <div class="v4-empty">Sektionen blev ikke fundet.</div>}
  </div>
</V4Layout>
