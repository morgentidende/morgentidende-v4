---
import V4Layout from '../../layouts/V4Layout.astro';
import V4Card from '../../components/V4Card.astro';
import { loadCategoryPageData } from '../../lib/category-data';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=120');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=60, stale-while-revalidate=120');

const { category: categorySlug } = Astro.params;
const { category, articles, backendUnavailable } = await loadCategoryPageData(categorySlug);

if (backendUnavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
} else if (!category) {
  Astro.response.status = 404;
}

const isMagazine = category?.name === 'Viden' || category?.name === 'Liv';
const pageTitle = category
  ? `${category.name} – Morgentidende`
  : backendUnavailable
    ? 'Midlertidigt utilgængelig – Morgentidende'
    : 'Ikke fundet – Morgentidende';
---
<V4Layout
  title={pageTitle}
  description={category?.description || (category ? `Seneste nyt fra ${category.name} på Morgentidende.` : '')}
  noindex={backendUnavailable || !category}
>
  <div class="v4-shell">
    {category ? (
      <>
        <header class:list={['v4-category-header', isMagazine && `v4-category-header--${category.slug}`]}>
          <div class="v4-kicker">{isMagazine ? 'Magasin' : 'Sektion'}</div>
          <h1>{category.name}</h1>
          {category.description ? <p>{category.description}</p> : null}
        </header>
        {backendUnavailable ? (
          <div class="v4-empty">Nyhederne kan ikke hentes lige nu. Prøv igen om et øjeblik.</div>
        ) : articles.length ? (
          <section class="v4-section">
            <div class="v4-grid-3">
              {articles.map((article) => <V4Card article={article} showDeck={true} />)}
            </div>
          </section>
        ) : <div class="v4-empty">Der er endnu ingen artikler i denne sektion.</div>}
      </>
    ) : backendUnavailable ? (
      <div class="v4-empty">Nyhederne kan ikke hentes lige nu. Prøv igen om et øjeblik.</div>
    ) : <div class="v4-empty">Sektionen blev ikke fundet.</div>}
  </div>
</V4Layout>
