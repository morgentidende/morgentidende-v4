---
import V4Layout from '../layouts/V4Layout.astro';
import V4Card from '../components/V4Card.astro';
import { v4Supabase } from '../lib/v4-supabase';
import '../styles/search.css';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=60');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=30, stale-while-revalidate=60');

const rawQ = Astro.url.searchParams.get('q') || '';
const q = rawQ.trim().replace(/[,%()]/g, ' ').replace(/\s+/g, ' ').slice(0, 120);
let results: any[] = [];
let categories: any[] = [];
let backendError = false;

if (q.length >= 2) {
  if (v4Supabase) {
    const pattern = `%${q}%`;
    const [articlesResult, categoriesResult] = await Promise.all([
      v4Supabase
        .from('v4_public_articles')
        .select('id,slug,category_id,story_cluster_id,headline,frontpage_headline,headline_accent_text,deck,hero_url,hero_alt,published_at')
        .or(`headline.ilike.${pattern},deck.ilike.${pattern},body_markdown.ilike.${pattern}`)
        .order('published_at', { ascending: false })
        .limit(40),
      v4Supabase
        .from('v4_public_categories')
        .select('id,name')
    ]);

    backendError = Boolean(articlesResult.error || categoriesResult.error);
    if (!backendError) {
      results = articlesResult.data || [];
      categories = categoriesResult.data || [];
    }
  } else {
    backendError = true;
  }
}

if (backendError) Astro.response.status = 503;

const categoryById = new Map(categories.map((c) => [c.id, c.name]));
const title = q ? `Søg: ${q} – Morgentidende` : 'Søg – Morgentidende';
---
<V4Layout title={title} description="Søg i Morgentidendes artikler">
  <section class="v4-search-page">
    <div class="v4-kicker">Arkiv</div>
    <h1>Søg i Morgentidende</h1>

    <form class="v4-search-form" method="get" action="/soeg">
      <input
        type="search"
        name="q"
        value={rawQ}
        placeholder="Søg efter emne, person eller begivenhed"
        aria-label="Søg i Morgentidende"
        minlength="2"
        maxlength="120"
        autofocus
      />
      <button type="submit">Søg</button>
    </form>

    {backendError ? (
      <p class="v4-search-empty">Nyhederne kan ikke hentes lige nu. Prøv igen om et øjeblik.</p>
    ) : q.length === 1 ? (
      <p class="v4-search-empty">Skriv mindst to tegn.</p>
    ) : q ? (
      <>
        <p class="v4-search-summary">{results.length} {results.length === 1 ? 'resultat' : 'resultater'} for “{q}”</p>
        {results.length ? (
          <div class="v4-grid-3">
            {results.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}
          </div>
        ) : (
          <p class="v4-search-empty">Ingen artikler matcher din søgning.</p>
        )}
      </>
    ) : (
      <p class="v4-search-empty">Søg frit i rubrikker, manchetter og artikeltekst.</p>
    )}
  </section>
</V4Layout>
