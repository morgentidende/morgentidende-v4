---
import V4Layout from '../layouts/V4Layout.astro';
import V4Card from '../components/V4Card.astro';
import LiveCenter from '../components/LiveCenter.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import '../styles/frontpage.css';
import '../styles/mobile-horizontal-cards.css';
import { loadFrontpageData } from '../lib/frontpage-data';
import { buildFrontpageModel } from '../lib/frontpage-model';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=60');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=30, stale-while-revalidate=60');

const { articles, categories, viden, liv, liveCenter, liveUpdates, loadError } = await loadFrontpageData();

if (loadError) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
}

const {
  categoryById,
  lead,
  leadType,
  followups,
  newsBarArticle,
  news,
  formerLead,
  formerLeadGraceActive,
  leadCategory
} = buildFrontpageModel(articles, categories);

const liveFollowups = liveCenter?.story_cluster_id
  ? articles
      .filter((article) => article.story_cluster_id === liveCenter.story_cluster_id)
      .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime())
      .slice(0, 3)
  : [];

const liveFollowupIds = new Set(liveFollowups.map((article) => article.id));
const displacedLeadPackage = liveCenter && lead ? [lead, ...followups] : [];
const frontpageNews = liveCenter
  ? [...displacedLeadPackage, ...news]
      .filter((article, index, all) => !liveFollowupIds.has(article.id) && all.findIndex((candidate) => candidate.id === article.id) === index)
      .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime())
      .slice(0, 15)
  : news;
---
<V4Layout image={lead?.hero_url} noindex={loadError}>
  <div class="v4-shell">
    {loadError ? <div class="v4-empty">Nyhederne kan ikke hentes lige nu. Prøv igen om et øjeblik.</div> : null}

    {!loadError && newsBarArticle ? (
      <aside class="v4-newsbar" aria-label="Seneste nyt">
        <div class="v4-newsbar__label"><span class="v4-newsbar__pulse" aria-hidden="true"></span>SENESTE NYT</div>
        <a class="v4-newsbar__headline" href={`/artikel/${newsBarArticle.slug}`}>{newsBarArticle.frontpage_headline || newsBarArticle.headline}</a>
      </aside>
    ) : null}

    {!loadError && liveCenter ? <LiveCenter center={liveCenter} updates={liveUpdates} relatedArticles={liveFollowups} categoryById={categoryById} /> : null}

    {!loadError && !liveCenter && lead ? (
      <section class:list={[leadType === 'breaking' ? 'v4-breaking-box' : 'v4-lead-box']}>
        <div class="v4-lead-label-row">
          {leadCategory ? <div class="v4-lead-label v4-lead-label--category">{leadCategory}</div> : null}
          {leadType === 'breaking' ? <div class="v4-lead-label v4-lead-label--breaking">BREAKING</div> : null}
        </div>
        <div class="v4-lead-layout">
          <div class="v4-lead-main"><V4Card article={lead} categoryName={leadCategory} showDeck={true} imageLoading="eager" imageFetchPriority="high" /></div>
          {followups.length ? (
            <div class="v4-followups-block">
              <div class="v4-followups-label">Læs også</div>
              <div class="v4-followups">{followups.map((article) => <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} />)}</div>
            </div>
          ) : null}
        </div>
      </section>
    ) : null}

    {!loadError && frontpageNews.length ? (
      <section class="v4-section v4-frontpage-news">
        <div class="v4-grid-3 v4-frontpage-primary">{frontpageNews.slice(0, 3).map((article) => <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} />)}</div>
        {frontpageNews.length > 3 ? (<>
          <div class="v4-frontpage-tier-divider" aria-hidden="true"></div>
          <div class="v4-grid-4 v4-frontpage-secondary">{frontpageNews.slice(3, 7).map((article) => <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} cardClass={formerLeadGraceActive && article.id === formerLead?.id ? 'v4-card--former-lead' : undefined} />)}</div>
        </>) : null}
      </section>
    ) : null}

    {!loadError ? <NewsletterSignup /> : null}

    {!loadError ? (
      <section class="v4-section v4-magazine v4-magazine--viden">
        <div class="v4-kicker">MAGASIN</div><h2 class="v4-section-title">Viden</h2>
        {viden.length ? <div class="v4-grid-4">{viden.map((article) => <V4Card article={article} showDeck={false} />)}</div> : <div class="v4-empty">Viden-blokken er klar til artikler.</div>}
      </section>
    ) : null}

    {!loadError ? (
      <section class="v4-section v4-magazine v4-magazine--liv">
        <div class="v4-kicker">MAGASIN</div><h2 class="v4-section-title">Liv</h2>
        {liv.length ? <div class="v4-grid-4">{liv.map((article) => <V4Card article={article} showDeck={false} />)}</div> : <div class="v4-empty">Liv-blokken er klar til artikler.</div>}
      </section>
    ) : null}

    {!loadError && frontpageNews.length > 7 ? (
      <section class="v4-section v4-latest-section">
        <h2 class="v4-latest-title">Seneste nyt</h2>
        <div class="v4-grid-4">{frontpageNews.slice(7, 15).map((article) => <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} />)}</div>
      </section>
    ) : null}
  </div>
</V4Layout>

<style>
  .v4-lead-main :global(.v4-card__deck) { max-width: 760px; margin-top: 12px; font-family: var(--v4-serif); font-size: clamp(16px, 1.45vw, 20px); line-height: 1.45; color: var(--v4-muted); }
  .v4-frontpage-tier-divider { width: 78%; height: 1px; margin: 26px auto 22px; background: var(--v4-rule); }
  .v4-frontpage-secondary { gap: 24px; }
  .v4-frontpage-secondary :global(.v4-card__headline) { font-size: clamp(18px, 1.45vw, 27px); }
  .v4-frontpage-secondary :global(.v4-card--former-lead) { grid-column: span 2; }
  .v4-frontpage-secondary :global(.v4-card--former-lead .v4-card__headline) { font-size: clamp(24px, 2.1vw, 34px); line-height: 1.08; }
  .v4-latest-title { margin: 0 0 20px; font-family: var(--v4-serif); font-size: clamp(26px, 3vw, 36px); line-height: 1.05; }
  @media (max-width: 640px) {
    .v4-lead-main :global(.v4-card__deck) { margin-top: 10px; font-size: 16px; line-height: 1.42; }
    .v4-frontpage-tier-divider { width: 82%; margin: 26px auto 22px; }
    .v4-frontpage-primary { row-gap: 20px; }
    .v4-latest-title { margin-bottom: 16px; font-size: 28px; }
  }
</style>
