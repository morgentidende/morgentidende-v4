---
import V4Layout from '../layouts/V4Layout.astro';
import V4Card from '../components/V4Card.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import '../styles/frontpage.css';
import { v4Supabase } from '../lib/v4-supabase';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=60');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=30, stale-while-revalidate=60');

let articles: any[] = [];
let categories: any[] = [];
let viden: any[] = [];
let liv: any[] = [];
let loadError = false;

const articleSelect = 'id,slug,category_id,story_cluster_id,headline,frontpage_headline,headline_accent_text,deck,hero_url,hero_alt,is_lead,is_breaking,breaking_until,published_at';

if (v4Supabase) {
  const [articlesResult, categoriesResult] = await Promise.all([
    v4Supabase
      .from('v4_public_articles')
      .select(articleSelect)
      .order('published_at', { ascending: false })
      .limit(64),
    v4Supabase.from('v4_public_categories').select('id,name,sort_order').order('sort_order', { ascending: true })
  ]);
  loadError = Boolean(articlesResult.error || categoriesResult.error);
  if (!loadError) {
    articles = articlesResult.data || [];
    categories = categoriesResult.data || [];

    const videnCategoryId = categories.find((c) => c.name === 'Viden')?.id;
    const livCategoryId = categories.find((c) => c.name === 'Liv')?.id;

    if (videnCategoryId) {
      const videnResult = await v4Supabase
        .from('v4_public_articles')
        .select(articleSelect)
        .eq('category_id', videnCategoryId)
        .order('published_at', { ascending: false })
        .limit(4);
      loadError = Boolean(videnResult.error);
      if (!videnResult.error) viden = videnResult.data || [];
    }

    if (!loadError && livCategoryId) {
      const livResult = await v4Supabase
        .from('v4_public_articles')
        .select(articleSelect)
        .eq('category_id', livCategoryId)
        .order('published_at', { ascending: false })
        .limit(4);
      loadError = Boolean(livResult.error);
      if (!livResult.error) liv = livResult.data || [];
    }
  }
} else {
  loadError = true;
}

if (loadError) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
}

const categoryById = new Map(categories.map((c) => [c.id, c.name]));
const breaking = articles.find((a) => a.is_breaking && (!a.breaking_until || new Date(a.breaking_until) > new Date()));
const standardLead = articles.find((a) => a.is_lead && !a.is_breaking);
const lead = breaking || standardLead;
const leadType = breaking ? 'breaking' : standardLead && categoryById.get(standardLead.category_id) === 'Tema' ? 'theme' : standardLead ? 'standard' : null;
const others = lead ? articles.filter((a) => a.id !== lead.id) : articles;
const followups = lead?.story_cluster_id
  ? others.filter((a) => a.story_cluster_id === lead.story_cluster_id).slice(0, 4)
  : lead ? others.slice(0, 3) : [];
const leadBoxIds = new Set([lead?.id, ...followups.map((a) => a.id)].filter(Boolean));
const newsBarArticle = lead
  ? articles.find((a) => !leadBoxIds.has(a.id) && !['Viden', 'Liv', 'Kommentar'].includes(categoryById.get(a.category_id)))
  : null;
const usedIds = new Set([...leadBoxIds, newsBarArticle?.id].filter(Boolean));
const stream = articles.filter((a) => !usedIds.has(a.id));

const newsCandidates = stream.filter((a) => !['Viden', 'Liv'].includes(categoryById.get(a.category_id)));
const leadPublishedAt = lead?.published_at ? new Date(lead.published_at).getTime() : Number.NaN;
const leadAgeMs = Number.isFinite(leadPublishedAt) ? Date.now() - leadPublishedAt : Number.POSITIVE_INFINITY;
const formerLeadGraceActive = Boolean(lead) && leadAgeMs >= 0 && leadAgeMs <= 2 * 60 * 60 * 1000;

const formerLead = lead
  ? newsCandidates.find((a) => {
      const publishedAt = a?.published_at ? new Date(a.published_at).getTime() : Number.NaN;
      return Number.isFinite(publishedAt)
        && publishedAt < leadPublishedAt
        && a.story_cluster_id !== lead.story_cluster_id;
    })
  : null;

let orderedNews = [...newsCandidates];
if (formerLeadGraceActive && formerLead) {
  orderedNews = orderedNews.filter((a) => a.id !== formerLead.id);
  orderedNews.splice(Math.min(3, orderedNews.length), 0, formerLead);
}
const news = orderedNews.slice(0, 15);
const leadCategory = lead ? categoryById.get(lead.category_id) : null;
---
<V4Layout image={lead?.hero_url} noindex={loadError}>
  <div class="v4-shell">
    {loadError ? <div class="v4-empty">Nyhederne kan ikke hentes lige nu. Prøv igen om et øjeblik.</div> : null}

    {!loadError && newsBarArticle ? (
      <aside class="v4-newsbar" aria-label="Seneste nyt">
        <div class="v4-newsbar__label"><span class="v4-newsbar__pulse" aria-hidden="true"></span>SENESTE NYT</div>
        <a class="v4-newsbar__headline" href={`/artikel/${newsBarArticle.slug}`}>
          {newsBarArticle.frontpage_headline || newsBarArticle.headline}
        </a>
      </aside>
    ) : null}

    {!loadError && lead ? (
      <section class={leadType === 'breaking' ? 'v4-breaking-box' : 'v4-lead-box'}>
        <div class="v4-lead-label-row">
          {leadCategory ? <div class="v4-lead-label v4-lead-label--category">{leadCategory}</div> : null}
          {leadType === 'breaking' ? <div class="v4-lead-label v4-lead-label--breaking">BREAKING</div> : null}
        </div>
        <div class="v4-lead-layout">
          <div class="v4-lead-main">
            <V4Card
              article={lead}
              categoryName={leadCategory}
              showDeck={true}
              imageLoading="eager"
              imageFetchPriority="high"
            />
          </div>
          {followups.length ? (
            <div class="v4-followups-block">
              <div class="v4-followups-label">Læs også</div>
              <div class="v4-followups">
                {followups.map((article) => (
                  <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} />
                ))}
              </div>
            </div>
          ) : null}
        </div>
      </section>
    ) : null}

    {!loadError && news.length ? (
      <section class="v4-section v4-frontpage-news">
        <div class="v4-grid-3 v4-frontpage-primary">
          {news.slice(0, 3).map((article) => (
            <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} />
          ))}
        </div>

        {news.length > 3 ? (
          <>
            <div class="v4-frontpage-tier-divider" aria-hidden="true"></div>
            <div class="v4-grid-4 v4-frontpage-secondary">
              {news.slice(3, 7).map((article) => (
                <V4Card
                  article={article}
                  categoryName={categoryById.get(article.category_id)}
                  showDeck={false}
                  cardClass={formerLeadGraceActive && article.id === formerLead?.id ? 'v4-card--former-lead' : undefined}
                />
              ))}
            </div>
          </>
        ) : null}
      </section>
    ) : null}

    {!loadError ? <NewsletterSignup /> : null}

    {!loadError ? (
      <section class="v4-section v4-magazine v4-magazine--viden">
        <div class="v4-kicker">MAGASIN</div>
        <h2 class="v4-section-title">Viden</h2>
        {viden.length ? (
          <div class="v4-grid-4">
            {viden.map((article) => <V4Card article={article} showDeck={false} />)}
          </div>
        ) : <div class="v4-empty">Viden-blokken er klar til artikler.</div>}
      </section>
    ) : null}

    {!loadError ? (
      <section class="v4-section v4-magazine v4-magazine--liv">
        <div class="v4-kicker">MAGASIN</div>
        <h2 class="v4-section-title">Liv</h2>
        {liv.length ? (
          <div class="v4-grid-4">
            {liv.map((article) => <V4Card article={article} showDeck={false} />)}
          </div>
        ) : <div class="v4-empty">Liv-blokken er klar til artikler.</div>}
      </section>
    ) : null}

    {!loadError && news.length > 7 ? (
      <section class="v4-section v4-latest-section">
        <h2 class="v4-latest-title">Seneste nyt</h2>
        <div class="v4-grid-4">
          {news.slice(7, 15).map((article) => (
            <V4Card article={article} categoryName={categoryById.get(article.category_id)} showDeck={false} />
          ))}
        </div>
      </section>
    ) : null}
  </div>
</V4Layout>

<style>
  .v4-lead-main :global(.v4-card__deck) {
    max-width: 760px;
    margin-top: 12px;
    font-family: var(--v4-serif);
    font-size: clamp(16px, 1.45vw, 20px);
    line-height: 1.45;
    color: var(--v4-muted);
  }

  .v4-frontpage-tier-divider {
    width: 78%;
    height: 1px;
    margin: 26px auto 22px;
    background: var(--v4-rule);
  }

  .v4-frontpage-secondary {
    gap: 24px;
  }

  .v4-frontpage-secondary :global(.v4-card__headline) {
    font-size: clamp(18px, 1.45vw, 27px);
  }

  .v4-frontpage-secondary :global(.v4-card--former-lead) {
    grid-column: span 2;
  }

  .v4-frontpage-secondary :global(.v4-card--former-lead .v4-card__headline) {
    font-size: clamp(24px, 2.1vw, 34px);
    line-height: 1.08;
  }

  .v4-latest-title {
    margin: 0 0 20px;
    font-family: var(--v4-serif);
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.05;
  }

  @media (max-width: 640px) {
    .v4-lead-main :global(.v4-card__deck) {
      margin-top: 10px;
      font-size: 16px;
      line-height: 1.42;
    }

    .v4-frontpage-tier-divider {
      width: 82%;
      margin: 26px auto 22px;
    }

    .v4-frontpage-secondary {
      gap: 0;
    }

    .v4-frontpage-secondary :global(.v4-card) {
      display: grid;
      grid-template-columns: minmax(0, 45%) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 14px;
      align-items: start;
      padding: 18px 0;
    }

    .v4-frontpage-secondary :global(.v4-card--former-lead) {
      grid-column: auto;
    }

    .v4-frontpage-secondary :global(.v4-card:first-child) {
      padding-top: 0;
    }

    .v4-frontpage-secondary :global(.v4-card + .v4-card) {
      border-top: 1px solid var(--v4-rule);
    }

    .v4-frontpage-secondary :global(.v4-card__media) {
      grid-column: 1;
      grid-row: 1 / span 2;
      width: 100%;
      min-height: 118px;
      aspect-ratio: 4 / 3;
    }

    .v4-frontpage-secondary :global(.v4-kicker) {
      grid-column: 2;
      grid-row: 1;
      margin: 1px 0 7px;
      font-size: 11px;
    }

    .v4-frontpage-secondary :global(.v4-card__headline),
    .v4-frontpage-secondary :global(.v4-card--former-lead .v4-card__headline) {
      grid-column: 2;
      grid-row: 2;
      margin: 0;
      font-size: clamp(20px, 5.6vw, 23px);
      line-height: 1.14;
    }

    .v4-latest-title {
      margin-bottom: 16px;
      font-size: 28px;
    }
  }
</style>
