---
import V4Layout from '../../layouts/V4Layout.astro';
import V4Card from '../../components/V4Card.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { loadArticlePageData } from '../../lib/article-data';
import { buildArticleRecommendations, buildBriefPoints } from '../../lib/article-view-helpers';
import { buildArticleMeta, buildSourceItems, formatArticleDateTime } from '../../lib/article-meta';
import { buildArticleBody } from '../../lib/article-body';
import { responsiveHeroCrop } from '../../lib/media';
import '../../styles/article-polish.css';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=120');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=60, stale-while-revalidate=120');

const { slug } = Astro.params;
const { article, storyRelated, recommendations, categories, backendError } = await loadArticlePageData(slug);

if (backendError) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
} else if (!article) {
  Astro.response.status = 404;
}

const categoryById = new Map(categories.map((c) => [c.id, c.name]));
const category = article ? categoryById.get(article.category_id) : '';
const { bodyHtml, remainingStoryRelated } = await buildArticleBody(article, storyRelated);
const briefPoints = buildBriefPoints(article);
const showBrief = briefPoints.length === 2;

const { relevantThree, currentThree } = buildArticleRecommendations(article, recommendations, storyRelated);
const heroIsGraphic = /\.(svg|png)(\?|$)/i.test(article?.hero_url || '') && (article?.hero_credit === 'Morgentidende grafik' || (article?.hero_url || '').includes('dsa-big-brother'));
const heroPhoto = !heroIsGraphic && article?.hero_url ? responsiveHeroCrop(article.hero_url) : null;
const siteBase = Astro.site || Astro.url.origin;
const sourceItems = buildSourceItems(article);
const showHeroCredit = Boolean(
  article?.hero_credit &&
  !['Morgentidende', 'Morgentidende grafik'].includes(article.hero_credit)
);
const {
  canonical,
  facebookShareUrl,
  publishedDate,
  updatedDate,
  articleTitle,
  displayAuthorName,
  headlineIsLong,
  headlineIsVeryLong,
  newsArticleLd
} = buildArticleMeta(article, backendError, category, siteBase);
---
<V4Layout
  title={articleTitle}
  description={article?.deck || article?.headline || (backendError ? 'Artiklen kan ikke hentes lige nu.' : undefined)}
  canonical={canonical}
  image={article?.hero_url}
  type="article"
  noindex={backendError || !article}
  jsonLd={newsArticleLd}
>
  {article ? (
    <>
      <header class="v4-article-header">
        {category ? <div class="v4-kicker">{category}</div> : null}
        <h1 class:list={['v4-article-title', headlineIsLong && 'v4-article-title--long', headlineIsVeryLong && 'v4-article-title--very-long']}>{article.headline}</h1>
        {article.deck ? <p class="v4-article-deck">{article.deck}</p> : null}
        <div class="v4-article-meta">
          <span>Af {displayAuthorName}</span>
          {publishedDate ? <time datetime={article.published_at}>Udgivet {formatArticleDateTime(publishedDate)}</time> : null}
          {updatedDate && publishedDate && updatedDate.getTime() > publishedDate.getTime() + 60000 ? <time datetime={article.updated_at}>Opdateret {formatArticleDateTime(updatedDate)}</time> : null}
        </div>
      </header>

      {showBrief ? (
        <aside class="v4-article-brief" aria-label="Sagen kort">
          <div class="v4-article-brief__title">Sagen kort</div>
          <ul>{briefPoints.map((point) => <li>{point}</li>)}</ul>
        </aside>
      ) : null}

      {article.hero_url ? (
        <figure class:list={["v4-article-hero", heroIsGraphic && "v4-article-hero--graphic"]}>
          {heroPhoto ? (
            <img
              src={heroPhoto.src}
              srcset={heroPhoto.srcset}
              sizes="(max-width: 640px) calc(100vw - 28px), min(980px, calc(100vw - 40px))"
              alt={article.hero_alt || article.headline}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="800"
            />
          ) : (
            <img src={article.hero_url} alt={article.hero_alt || article.headline} loading="eager" fetchpriority="high" decoding="async" />
          )}
        </figure>
      ) : null}

      <article class="v4-article-body"><div set:html={bodyHtml} /></article>

      {sourceItems.length ? (
        <section class="v4-article-sources" aria-labelledby="article-sources-title">
          <h2 id="article-sources-title">Kilder</h2>
          <ul>{sourceItems.map((source: any) => (<li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>))}</ul>
        </section>
      ) : null}

      {showHeroCredit ? (
        <div class="v4-article-image-credit" aria-label="Billedkreditering">
          <span>Billede: </span>
          {article.hero_source_url ? (
            <a href={article.hero_source_url} target="_blank" rel="noopener noreferrer">{article.hero_credit}</a>
          ) : article.hero_credit}
          {article.hero_license ? <span> · {article.hero_license}</span> : null}
          {article.hero_license_url ? (<span> · <a href={article.hero_license_url} target="_blank" rel="noopener noreferrer">Licens</a></span>) : null}
        </div>
      ) : null}

      <div class="v4-article-share" aria-label="Del artikel">
        <a class="v4-share-action" href={facebookShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Del på Facebook">
          <span class="v4-share-facebook" aria-hidden="true">f</span><span>Facebook</span>
        </a>
        <button class="v4-share-action v4-copy-link" type="button" data-copy-link={canonical || ''}>
          <span class="v4-share-link-icon" aria-hidden="true">↗</span><span class="v4-copy-label">Kopier link</span>
        </button>
      </div>

      <div class="v4-article-newsletter">
        {category === 'Viden' || category === 'Liv' ? <NewsletterSignup variant="weekly" magazineName={category} /> : <NewsletterSignup />}
      </div>

      {remainingStoryRelated.length ? (
        <section class="v4-story-related">
          <div class="v4-story-related__label">Mere om sagen</div>
          <div class="v4-story-related__grid">{remainingStoryRelated.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}</div>
        </section>
      ) : null}

      <div class="v4-shell">
        {relevantThree.length ? (
          <section class="v4-section v4-article-recommendations">
            <h2 class="v4-article-recommendations__title">Læs videre</h2>
            <div class="v4-grid-3">{relevantThree.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}</div>
          </section>
        ) : null}
        {currentThree.length ? (
          <section class="v4-article-recommendations--secondary">
            <div class="v4-grid-3">{currentThree.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}</div>
          </section>
        ) : null}
      </div>
    </>
  ) : (
    <div class="v4-shell"><div class="v4-empty">{backendError ? 'Artiklen kan ikke hentes lige nu. Prøv igen om et øjeblik.' : 'Artiklen blev ikke fundet.'}</div></div>
  )}
</V4Layout>

<style>
  .v4-article-sources, .v4-article-image-credit, .v4-article-share { width: min(100% - 32px, 760px); margin-left: auto; margin-right: auto; }
  .v4-article-sources { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--v4-border, rgba(20, 24, 38, 0.16)); }
  .v4-article-sources h2 { margin: 0 0 .65rem; font-size: .78rem; line-height: 1; text-transform: uppercase; letter-spacing: .11em; }
  .v4-article-sources ul { margin: 0; padding-left: 1.15rem; }
  .v4-article-sources li { margin: .35rem 0; font-size: .94rem; }
  .v4-article-sources a, .v4-article-image-credit a { text-decoration: underline; text-underline-offset: 2px; }
  .v4-article-image-credit { margin-top: 1rem; font-size: .72rem; line-height: 1.35; color: var(--v4-muted); }
  .v4-article-share { display: flex; gap: 1.4rem; align-items: center; margin-top: 1.6rem; margin-bottom: 1.8rem; }
  .v4-share-action { display: inline-flex; align-items: center; gap: .48rem; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; font-size: .86rem; font-weight: 650; text-transform: uppercase; text-decoration: none; cursor: pointer; }
  .v4-share-facebook { display: inline-grid; place-items: center; width: 1.15rem; height: 1.15rem; background: currentColor; color: var(--v4-bg, #fff); font-family: Arial, sans-serif; font-weight: 800; line-height: 1; }
  .v4-share-link-icon { font-size: 1.2rem; line-height: 1; transform: rotate(-45deg); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.v4-copy-link').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.copyLink || window.location.href;
      const label = button.querySelector<HTMLElement>('.v4-copy-label');
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = 'Link kopieret';
        window.setTimeout(() => { if (label) label.textContent = 'Kopier link'; }, 1800);
      } catch {
        window.prompt('Kopier link:', url);
      }
    });
  });
</script>