---
import V4Layout from '../../layouts/V4Layout.astro';
import V4Card from '../../components/V4Card.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { v4Supabase } from '../../lib/v4-supabase';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import '../../styles/article-polish.css';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=120');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=60, stale-while-revalidate=120');

const { slug } = Astro.params;
let article: any = null;
let related: any[] = [];
let clusterRelated: any[] = [];
let recommendations: any[] = [];
let categories: any[] = [];

const articleFields = 'id,slug,category_id,story_cluster_id,headline,deck,body_markdown,author_name,hero_url,hero_alt,hero_credit,hero_license,published_at,updated_at';
const cardFields = 'id,slug,category_id,story_cluster_id,headline,frontpage_headline,headline_accent_text,deck,hero_url,hero_alt,published_at';

if (v4Supabase && slug) {
  const [articleResult, categoriesResult] = await Promise.all([
    v4Supabase
      .from('v4_public_articles')
      .select(articleFields)
      .eq('slug', slug)
      .maybeSingle(),
    v4Supabase
      .from('v4_public_categories')
      .select('id,name,sort_order')
      .order('sort_order', { ascending: true })
  ]);

  article = articleResult.data;
  categories = categoriesResult.data || [];

  if (article) {
    const relationQuery = v4Supabase
      .from('v4_public_relations')
      .select('related_article_id,sort_order')
      .eq('article_id', article.id)
      .order('sort_order', { ascending: true });

    const clusterQuery = article.story_cluster_id
      ? v4Supabase
          .from('v4_public_articles')
          .select(cardFields)
          .eq('story_cluster_id', article.story_cluster_id)
          .neq('id', article.id)
          .order('published_at', { ascending: true })
      : Promise.resolve({ data: [] });

    const recommendationsQuery = v4Supabase
      .from('v4_public_articles')
      .select(cardFields)
      .neq('id', article.id)
      .order('published_at', { ascending: false })
      .limit(28);

    const [relationResult, clusterResult, recResult] = await Promise.all([
      relationQuery,
      clusterQuery,
      recommendationsQuery
    ]);

    clusterRelated = clusterResult.data || [];
    recommendations = recResult.data || [];

    const relatedIds = Array.from(new Set((relationResult.data || []).map((r) => r.related_article_id)));
    if (relatedIds.length && !clusterRelated.length) {
      const relatedResult = await v4Supabase
        .from('v4_public_articles')
        .select(cardFields)
        .in('id', relatedIds);
      const byId = new Map((relatedResult.data || []).map((a) => [a.id, a]));
      related = relatedIds.map((id) => byId.get(id)).filter(Boolean);
    }
  }
}

if (!article) Astro.response.status = 404;

const categoryById = new Map(categories.map((c) => [c.id, c.name]));
const category = article ? categoryById.get(article.category_id) : '';
const bodyHtml = article
  ? sanitizeHtml(await marked.parse(article.body_markdown || ''), {
      allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'figure', 'figcaption']),
      allowedAttributes: {
        ...sanitizeHtml.defaults.allowedAttributes,
        img: ['src', 'alt', 'title', 'loading'],
        a: ['href', 'title', 'target', 'rel']
      }
    })
  : '';

const storyRelated = clusterRelated.length ? clusterRelated : related;
const storyRelatedIds = new Set(storyRelated.map((a) => a.id));
const firstThree = recommendations
  .filter((a) => !storyRelatedIds.has(a.id))
  .sort((a, b) => {
    const aScore = (a.story_cluster_id && a.story_cluster_id === article?.story_cluster_id ? 4 : 0) + (a.category_id === article?.category_id ? 2 : 0);
    const bScore = (b.story_cluster_id && b.story_cluster_id === article?.story_cluster_id ? 4 : 0) + (b.category_id === article?.category_id ? 2 : 0);
    return bScore - aScore;
  })
  .slice(0, 3);
const used = new Set([...firstThree, ...storyRelated].map((a) => a.id));
const finalFour = recommendations.filter((a) => !used.has(a.id)).slice(0, 4);
const heroIsGraphic = /\.(svg|png)(\?|$)/i.test(article?.hero_url || '') && (article?.hero_credit === 'Morgentidende grafik' || (article?.hero_url || '').includes('dsa-big-brother'));
const canonical = article ? new URL(`/artikel/${article.slug}`, Astro.site || Astro.url.origin).toString() : undefined;
const publishedDate = article?.published_at ? new Date(article.published_at) : null;
const updatedDate = article?.updated_at ? new Date(article.updated_at) : publishedDate;
const formatDateTime = (value: Date) => new Intl.DateTimeFormat('da-DK', {
  day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Copenhagen'
}).format(value);
const articleTitle = article ? `${article.headline} – Morgentidende` : 'Ikke fundet – Morgentidende';
const authorName = article?.author_name?.trim();
const showAuthor = authorName && authorName.toLocaleLowerCase('da-DK') !== 'morgentidende';
const newsArticleLd = article ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.headline,
  description: article.deck || undefined,
  datePublished: article.published_at,
  dateModified: article.updated_at || article.published_at,
  mainEntityOfPage: canonical,
  image: article.hero_url ? [article.hero_url] : undefined,
  articleSection: category || undefined,
  author: showAuthor
    ? { '@type': 'Person', name: authorName }
    : { '@type': 'Organization', name: 'Morgentidende', url: new URL('/', Astro.site || Astro.url.origin).toString() },
  publisher: {
    '@type': 'Organization',
    name: 'Morgentidende',
    url: new URL('/', Astro.site || Astro.url.origin).toString(),
    logo: { '@type': 'ImageObject', url: new URL('/morgentidende-sun.png', Astro.site || Astro.url.origin).toString() }
  }
} : undefined;
---
<V4Layout
  title={articleTitle}
  description={article?.deck || article?.headline}
  canonical={canonical}
  image={article?.hero_url}
  type="article"
  noindex={!article}
  jsonLd={newsArticleLd}
>
  {article ? (
    <>
      <header class="v4-article-header">
        {category ? <div class="v4-kicker">{category}</div> : null}
        <h1 class="v4-article-title">{article.headline}</h1>
        {article.deck ? <p class="v4-article-deck">{article.deck}</p> : null}
        <div class="v4-article-meta">
          {showAuthor ? <span>Af {authorName}</span> : null}
          {publishedDate ? <time datetime={article.published_at}>Udgivet {formatDateTime(publishedDate)}</time> : null}
          {updatedDate && publishedDate && updatedDate.getTime() > publishedDate.getTime() + 60000 ? <time datetime={article.updated_at}>Opdateret {formatDateTime(updatedDate)}</time> : null}
        </div>
      </header>

      {article.hero_url ? (
        <figure class:list={["v4-article-hero", heroIsGraphic && "v4-article-hero--graphic"]}>
          <img src={article.hero_url} alt={article.hero_alt || article.headline} loading="eager" fetchpriority="high" decoding="async" />
          {(article.hero_credit || article.hero_license) && article.hero_credit !== 'Morgentidende grafik' ? (
            <figcaption class="v4-hero-credit">
              {article.hero_credit ? `Foto: ${article.hero_credit}` : ''}
              {article.hero_credit && article.hero_license ? ' · ' : ''}
              {article.hero_license || ''}
            </figcaption>
          ) : null}
        </figure>
      ) : null}

      <article class="v4-article-body"><div set:html={bodyHtml} /></article>

      <div class="v4-article-signoff">Morgentidende giver dig argumenterne. Hvad du mener om dem, er op til dig.</div>

      <div class="v4-article-newsletter">
        {category === 'Viden' || category === 'Liv'
          ? <NewsletterSignup variant="weekly" magazineName={category} />
          : <NewsletterSignup />}
      </div>

      {storyRelated.length ? (
        <section class="v4-story-related">
          <div class="v4-story-related__label">Læs også</div>
          <div class="v4-story-related__grid">
            {storyRelated.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}
          </div>
        </section>
      ) : null}

      <div class="v4-shell">
        {firstThree.length ? (
          <section class="v4-section v4-article-recommendations">
            <h2 class="v4-article-recommendations__title">Mere fra Morgentidende</h2>
            <div class="v4-grid-3">{firstThree.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}</div>
          </section>
        ) : null}
        {finalFour.length ? (
          <section class="v4-article-recommendations--secondary">
            <div class="v4-grid-4">{finalFour.map((item) => <V4Card article={item} categoryName={categoryById.get(item.category_id)} />)}</div>
          </section>
        ) : null}
      </div>
    </>
  ) : <div class="v4-shell"><div class="v4-empty">Artiklen blev ikke fundet.</div></div>}
</V4Layout>
