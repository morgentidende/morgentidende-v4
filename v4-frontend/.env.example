PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only runtime secrets for Cloudflare Worker (wrangler secret put).
# Do not commit values. Do not bake these into the client bundle.
# SUPABASE_SECRET_KEY is the service-role key used only on the Worker.
SUPABASE_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-north-1
# Optional override. Default in code: Morgentidende <nyhedsbrev@morgentidende.dk>
NEWSLETTER_FROM=
