{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morgentidende-v4",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 4 * * *", "0 5 * * *"]
  },
  "vars": {
    "PUBLIC_SUPABASE_URL": "https://lfttxjxfggjcxmdfjndk.supabase.co",
    "AWS_SES_REGION": "eu-north-1"
  }
}
